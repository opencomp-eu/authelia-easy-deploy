# authelia-easy-deploy — operator configuration
# Copy to deploy.yaml and run: bash apply.sh

authelia:
  domain: auth.example.com
  sso_domain: example.com
  image: docker.io/authelia/authelia
  tag: "4.39.4"
  data_dir: /var/lib/authelia

proxy:
  type: caddy
  # standalone — this kit runs its own Caddy on :443 (single-service VPS)
  # integrate — join easydeploy-net; easydeploy-engine owns Caddy (multi-service VPS)
  mode: standalone
  integrate:
    network: easydeploy-net

storage:
  type: postgres

session:
  redis:
    enabled: false

authentication:
  backend: file

users:
  - username: admin
    display_name: Admin
    email: admin@example.com
    groups:
      - opencloud-admin
      - matrix-admins

notifier:
  type: smtp
  smtp:
    host: ""
    port: 587
    username: ""
    from: "Authelia <noreply@example.com>"

access_control:
  default_policy: deny
  rules:
    - domain: "*.example.com"
      policy: one_factor

oidc:
  enabled: true
  # The OIDC provider is only written to configuration.yml when this list is non-empty.
  clients: []
  # Example (OpenCloud) — see https://www.authelia.com/configuration/identity-providers/openid-connect/clients/
  # clients:
  #   - client_id: opencloud
  #     client_name: OpenCloud
  #     client_secret:
  #       "$plaintext$your-secret-here"
  #     public: false
  #     authorization_policy: two_factor
  #     redirect_uris:
  #       - https://cloud.example.com/oidc/callback
  #     scopes:
  #       - openid
  #       - profile
  #       - email
  #       - groups
  #     grant_types:
  #       - authorization_code
  #     response_types:
  #       - code
  #     token_endpoint_auth_method: client_secret_basic
